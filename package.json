{
  "name": "coursesmith-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "typecheck": "tsc",
    "deck:m1": "node scripts/decks/build-m1-deck.mjs",
    "deck:m2": "node scripts/decks/build-m2-deck.mjs",
    "deck:m3": "node scripts/decks/build-m3-deck.mjs",
    "deck:m4": "node scripts/decks/build-m4-deck.mjs",
    "deck:m5": "node scripts/decks/build-m5-deck.mjs",
    "deck:check": "node --test tests/decks/*.test.mjs && node scripts/decks/validate-deck.mjs static/decks/m1-agentic-iac-fundamentals.html --fresh && node scripts/decks/validate-deck.mjs static/decks/m2-first-iac-change-ai-coding-agent.html --fresh && node scripts/decks/validate-deck.mjs static/decks/m3-plan-iac-before-agent-codes.html && node scripts/decks/validate-deck.mjs static/decks/m4-give-iac-agent-right-context.html && node scripts/decks/validate-deck.mjs static/decks/m5-connect-iac-agent-tools-skills-mcp.html",
    "deck:render:m1": "node scripts/decks/render-m1-deck.mjs",
    "deck:render:m2": "node scripts/decks/render-m2-deck.mjs",
    "deck:render:m3": "node scripts/decks/render-m3-deck.mjs",
    "deck:render:m4": "node scripts/decks/render-m4-deck.mjs",
    "deck:render:m5": "node scripts/decks/render-m5-deck.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.1",
    "@docusaurus/faster": "3.10.1",
    "@docusaurus/preset-classic": "3.10.1",
    "@docusaurus/theme-mermaid": "3.10.1",
    "@mdx-js/react": "^3.0.0",
    "@mermaid-js/parser": "^1.2.0",
    "clsx": "^2.0.0",
    "mermaid": "^11.16.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.1",
    "@docusaurus/tsconfig": "3.10.1",
    "@docusaurus/types": "3.10.1",
    "@types/react": "^19.0.0",
    "typescript": "~6.0.2"
  },
  "engines": { "node": ">=20.0" }
}
